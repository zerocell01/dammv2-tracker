{
  "name": "dammv2-tracker",
  "version": "1.0.0",
  "description": "Telegram alert bot for tracking Meteora DAMM v2 open/close LP positions of watched Solana wallets",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "bs58": "^5.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "node-telegram-bot-api": "^0.66.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/node-telegram-bot-api": "^0.64.7",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
