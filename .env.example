# Telegram
TELEGRAM_BOT_TOKEN=123456:abc-your-bot-token
# Optional: restrict bot commands (/addwallet, /removewallet) to this Telegram user id.
# Leave empty to allow anyone who can message the bot to manage wallets.
TELEGRAM_ADMIN_ID=

# Helius (https://helius.dev) - used for real-time WebSocket log subscription
# and parsing raw transactions into enhanced (human-readable) transactions.
HELIUS_API_KEY=your-helius-api-key
# Usually no need to change these:
HELIUS_WS_URL=wss://mainnet.helius-rpc.com
HELIUS_PARSE_TX_URL=https://api-mainnet.helius-rpc.com/v0/transactions

# Local health-check HTTP server port (no public exposure needed)
PORT=3000

# SQLite file path
DB_PATH=./data/tracker.db

# Jupiter Price API base (v2 lite endpoint, no key required)
JUPITER_PRICE_API=https://lite-api.jup.ag/price/v2

# Link templates. {wallet} / {pool} placeholders get substituted.
# NOTE: the exact lpAgent.io portfolio/pool URL patterns are best-effort guesses;
# verify against real lpAgent.io links and adjust if needed.
PORTO_URL_TEMPLATE=https://lpagent.io/portfolio/{wallet}
POOL_URL_TEMPLATE=https://lpagent.io/pools/{pool}
GMGN_URL_TEMPLATE=https://gmgn.ai/sol/address/{wallet}
